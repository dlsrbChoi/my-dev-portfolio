# Notion API 환경변수 설정 예시
# 이 파일을 복사해 .env.local 파일을 만들고 실제 값을 입력하세요.

# Notion Integration Token
# 발급 방법: Notion 워크스페이스 Settings → Connections → Develop your own integrations
#           → Create new integration 생성 후 "Internal Integration Token" 복사
# 예: ntn_xxx...
NOTION_API_KEY=

# Notion Projects Database ID
# 확인 방법: Projects Database URL에서 다음 형식 부분 추출
#           https://notion.so/{workspace_id}/{DATABASE_ID}?v=...
# 예: abc123def456ghi789...
NOTION_PROJECTS_DB_ID=

# Notion Resume/Experience Database ID
# 확인 방법: Resume Database URL에서 다음 형식 부분 추출
#           https://notion.so/{workspace_id}/{DATABASE_ID}?v=...
# 예: def456ghi789jkl012...
NOTION_RESUME_DB_ID=
